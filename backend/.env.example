PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: set HOST=0.0.0.0 behind HTTPS; add your frontend origin above.
# DB_PATH=/absolute/path/on/persistent-disk/blog.sqlite

# Free online deployment: Neon PostgreSQL (keep the real URL private).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# REQUIRE_POSTGRES=true
# TRUST_PROXY_HOPS=1
# CORS_ORIGINS=https://weizhiqq0-glitch.github.io
# With no DATABASE_URL, local development keeps using SQLite.

# Email verification for local Node development (real keys stay in .env):
# EMAIL_PROVIDER=emailjs
# EMAILJS_SERVICE_ID=service_your_id
# EMAILJS_TEMPLATE_ID=template_your_id
# EMAILJS_PUBLIC_KEY=your-public-key
# EMAILJS_PRIVATE_KEY=your-private-key
# Enable server/non-browser API requests and require Private Key in EmailJS security settings.
# Alternate provider: EMAIL_PROVIDER=brevo with BREVO_API_KEY and verified EMAIL_FROM.
# Alternate provider: EMAIL_PROVIDER=resend with RESEND_API_KEY and a verified sender.
